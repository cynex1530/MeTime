{
  "expo": {
    "name": "Me Time",
    "slug": "metime",
    "version": "1.0.0",
    "scheme": "metime",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#f2f2f7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.metime.mobile"
    },
    "android": {
      "package": "app.metime.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1c1c1e"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
