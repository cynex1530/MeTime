{
  "expo": {
    "name": "Me Time",
    "slug": "metime",
    "version": "1.0.0",
    "scheme": "metime",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#f2f2f7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.metime.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Me Time uses your location to show salons and artists near you."
      }
    },
    "android": {
      "package": "app.metime.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1c1c1e"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Me Time uses your location to show salons and artists near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
