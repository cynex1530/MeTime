# Copy to .env and fill in from your Supabase project settings (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google Places autocomplete (optional) — for address suggestions when adding a
# location. Google Cloud → enable billing + "Places API (New)" → create a key.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=YOUR-GOOGLE-PLACES-KEY
